{
  "version": 3,
  "configurePresets": [
    {
      "name": "ci-linux-debug",
      "displayName": "Linux Debug (CI)",
      "description": "Debug build for Linux CI",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTS": "ON",
        "BUILD_SHARED_LIBS": "OFF"
      }
    },
    {
      "name": "ci-windows-release",
      "displayName": "Windows Release (CI)",
      "description": "Release build for Windows CI",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/windows-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTS": "ON",
        "BUILD_SHARED_LIBS": "OFF"
      }
    }
  ]
}
